# Copia este archivo como .env y cambia todos los valores sensibles.

COMPOSE_PROJECT_NAME=urbelix
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
APP_DOMAIN=urbelix.tudominio.com

MYSQL_DATABASE=nexur_db
MYSQL_USER=urbelix_app
MYSQL_PASSWORD=cambia-esta-clave-de-la-base
MYSQL_ROOT_PASSWORD=cambia-esta-clave-root

# En HTTP local debe ser false. Usa true cuando APP_BASE_URL sea HTTPS.
SESSION_COOKIE_SECURE=false

# FastAPI es opcional; Spring Boot conserva un generador PDF local de respaldo.
REPORTS_FASTAPI_ENABLED=true

# Primera instalación: habilita temporalmente el bootstrap del administrador.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_EMAIL=admin@tu-dominio.com
ADMIN_BOOTSTRAP_PASSWORD=cambia-esta-clave-admin

ADMINISTRATION_AMOUNT=300000
PASSWORD_RESET_EXPIRATION_MINUTES=30

# SMTP opcional para recuperación de contraseña y avisos PQRS.
NOTIFICATIONS_EMAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# Pagos: simulación local, sin API externa ni credenciales.
PAYMENTS_SIMULATION_ENABLED=true

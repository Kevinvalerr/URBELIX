# Variables para levantar MySQL y la aplicacion con Docker Compose.
MYSQL_DATABASE=nexur_db
MYSQL_USER=urbelix_app
MYSQL_PASSWORD=cambia-esta-clave
MYSQL_ROOT_PASSWORD=cambia-esta-clave-root
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
PORTAL_URL=http://localhost:8080/login

# Acceso administrativo inicial. Activarlo solo durante el primer despliegue
# o para recuperar el acceso; luego dejar ADMIN_BOOTSTRAP_ENABLED=false.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_EMAIL=admin@urbelix.local
ADMIN_BOOTSTRAP_PASSWORD=

# Opcional: conexion MySQL externa en vez del servicio db del compose.
SPRING_PROFILES_ACTIVE=prod
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
